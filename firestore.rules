rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 管理者は Firestore の admins/{UID} ドキュメントの存在で判定します。
    // 管理者を変更するときはコードやルールのUIDを書き換えるのではなく、
    // Firebase Console で admins コレクションのドキュメントを変更してください。
    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    function validAnswer(questionId, teamId) {
      return request.resource.data.keys().hasOnly([
          "teamId",
          "questionId",
          "ranking",
          "writerUid",
          "updatedAt"
        ])
        && request.resource.data.teamId == teamId
        && request.resource.data.questionId == questionId
        && request.resource.data.writerUid == request.auth.uid
        && request.resource.data.ranking is list
        && request.resource.data.ranking.size() == 3
        && request.resource.data.ranking[0] is string
        && request.resource.data.ranking[1] is string
        && request.resource.data.ranking[2] is string
        && request.resource.data.ranking[0] != request.resource.data.ranking[1]
        && request.resource.data.ranking[0] != request.resource.data.ranking[2]
        && request.resource.data.ranking[1] != request.resource.data.ranking[2];
    }

    // 管理者登録。
    // Webアプリから追加・削除はできません。
    // Firebase Console から admins/{管理者UID} を作成してください。
    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // 問題ごとの「受付中 / 締切」
    match /controls/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // 正解データ
    match /answerKeys/{questionId} {
      allow read, write: if isAdmin();
    }

    // 参加者回答
    match /answers/{questionId}/teams/{teamId} {
      allow read: if isAdmin();

      // 同じ teamId のドキュメントへ setDoc するため、
      // 同一チームが再回答した場合は最後の正常送信で上書きされます。
      allow create, update: if signedIn()
        && !isAdmin()
        && validAnswer(questionId, teamId)
        && get(
          /databases/$(database)/documents/controls/$(questionId)
        ).data.isOpen == true;

      allow delete: if isAdmin();
    }
  }
}
